title: Next month
on-arrival: {!if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Q.advisor_action_timer + ' months.';
}
if (Q.sfio_in_government && Q.prime_minister_party == "SFIO") {
    Q.pinnedCardsDescription += ' The Cabinet is always available as long as the prime minister is in the SFIO.';
}!}
set-bg: img/map.jpg
is-hand: true
max-cards: 3
  
- @party
- @govt
- #advisor

