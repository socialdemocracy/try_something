Q.us_relation = 60;
Q.uk_relation = 65;
Q.ussr_relation = 40;
Q.italy_relation = 22;
Q.germany_relation = 10;
Q.spain_relation = 50;
Q.low_countries_relation = 60;
Q.poland_relation = 45;
Q.little_entente_relation = 50;

Q.poland_germany_relation = 40;

// foreign events
Q.little_entente_broken = 0;
Q.belgium_neutral = 0;

// Events: what has occurred? //////////////////////////////
// progress

// have we reformed these institutions to be more democratic?
Q.bureaucratic_reform = 0;
Q.military_reform = 0;
Q.womens_rights = 0;
// social welfare: have we implemented national unemployment insurance?
Q.unemployment_insurance = 0;
// Have we implemented a national pension system?
Q.pensions = 0;
// Have we implemented national health insurance?
Q.healthcare = 0;
// level of support for farmers
Q.agricultural_policy = 0;
Q.land_reform = 0;
// public works programs - how much have they implemented?
Q.works_program = 0;


// nationalization_progress is part of the left economic plan.
Q.nationalization = 0;
Q.socializations = 0;
// have there been any factory takeovers?
Q.factory_takeovers = 0;

// science: have we funded science?
Q.science = 0;
Q.education_science = 0;
Q.nuclear_science = 0;

// Tax rates...
Q.lower_tax_rates = 0;
Q.upper_tax_rates = -1;
Q.tariffs = 0;

// our conduct in the government, and the conduct of our coalition opponents.
// did the SFIO vote against the previous government in a vote of no confidence?
Q.sfio_no_confidence = 0;
// was the last SFIO government taken down in a vote of no confidence by right-wing coalition partners?
Q.no_confidence_against_sfio = 0;

// Maximum number of advisors/Leaders
Q.n_advisors = 3;
// Advisor action timer
Q.advisor_cooldown = 5;
Q.advisor_action_timer = 0;


// n_elections is the number of elections that have happened since the start of the game.
Q.n_elections = 0;
// number of elections without a clear majority.
Q.no_majority_elections = 0;
// elections are not on a timer, but rather there is an indicator for whether you're in an electoral cycle.
Q.in_election = 1;
Q.next_election_year = 1936;
Q.next_election_month = 5;
Q.next_election_time = 5;

Q.timers = [];

// Note: we don't need to pre-declare all timers here because we just iterate through every variable looking for timers.

// SFIO Centrists and reformists
Q.blum_advisor = 1; // Léon Blum
Q.faure_advisor = 1; // Paul Faure
Q.auriol_advisor = 1; // Vincent Auriol

// SFIO left
Q.pivert_advisor = 0; // Marceau Pivert
Q.zyromski_advisor = 0; // Jean Zyromski

// SFIO Government
Q.salengro_advisor = 0; // Roger Salengro (interior)
Q.salengro_dead = 0;
Q.dormoy_advisor = 0; // Marx Dormoy (interior)
Q.spinasse_advisor = 0; // Charles Spinasse (National Economy)
Q.bedouce_advisor = 0; // Albert Bedouce (Public Works)
Q.moutet_advisor = 0; // Marius Moutet (Colonies)
Q.lebas_advisor = 0; // Jean-Baptiste Lebas (Labor)
Q.lacore_advisor = 0; // Suzanne Lacore
Q.lagrange_advisor = 0; // Léo Lagrange (Sports)

// Popular Frontists
Q.daladier_advisor = 0; // Edouard Daladier (PRRRS)
Q.thorez_advisor = 0; // Maurice Thorez (PCF)
Q.paul_boncour_advisor = 0; // Joseph Paul-Boncour (URS)
Q.jouhaux_advisor = 0; // Léon Jouhaux (CGT)
// Nonfactional Popular Front Advisors
Q.joliot_curie_advisor = 0; //Irène Joliot-Curie
Q.brunschvicg_advisor = 0; //Cécile Brunschvicg

// Secret advisors
Q.ho_advisor = 0; // Ho Chi Minh
Q.lamine_gueye_advisor = 0; // Amadou Lamine-Guèye
Q.guerin_advisor = 0; // Daniel Guérin
Q.degaulle_advisor = 0; // Charles De Gaulle
!}
new-page: true
set-bg: img/map_2.jpg
  
> *"No one knows better than I that my generation failed in its task. Yet I do not propose to defend it, but rather to try to point out to the rising generation—and to those to whom we shall pass on our burdens tomorrow—what can be learnt from our mistakes, our illusions and our misfortunes. That lesson will be of more use to others than to us."*

> *"Léon Blum, *For All Mankind (À l'échelle humaine)*, 1941"*

This is a game of alternate history. While historical accuracy is a major concern, keep in mind that this is a *game*, and that any divergence from actual events will necessarily have to involve some element of make-believe. Nevertheless, please let the author know if there are any glaring mistakes.

For more information on the politics and government of the French Third Republic, see the "Library" page on the top left. If this is your first time playing the game, it is recommended that you read at least some of this information.

- @1936_easy: Begin (easy difficulty)
- @1936_main: Begin (normal difficulty)
- @1936_hard: Begin (hard difficulty)

@1936_hard
on-arrival: {!Q['difficulty'] = 1;
Q['resources'] = 2;
Q['dues'] = 1;
Q['budget'] = 0;
Q['global_max_gov_actions'] = 5;
Q['global_max_gov_actions_coalition'] = 2;
Q['total_debt_limit'] = 10;
Q['advisor_cooldown'] = 6;
Q['senate_relation'] = 40;!}
go-to: 1936_main

@1936_easy
on-arrival: {!Q['difficulty'] = -1;
Q['resources'] = 4;
Q['dues'] = 3;
Q['pcf_relation'] = 60;
Q['prrrs_relation'] = 60;
Q['ad_relation'] = 40;
Q['budget'] = 2;
Q['global_max_gov_actions'] = 7;
Q['global_max_gov_actions_coalition'] = 4;
Q['total_debt_limit'] = 20;
Q['advisor_cooldown'] = 4;
Q['senate_relation'] = 50;!}
go-to: 1936_main
                               
@1936_main
go-to: main if {!return ((Q['difficulty'] || 0) >= 0);!}; main.main_easy if {!return ((Q['difficulty'] || 0) < 0);!}
new-page: true
audio: shuffle music/LaVoixduFrontPopulaire.mp3 music/MaBlondeAllonsAuDevantDeLaVie.mp3 music/FaureFantasie.ogg music/LaMarseillaiseAldaNormalized.mp3 music/InternationaleGhasneNormalized.mp3 music/LeDrapeauRouge.mp3 music/LeChantDesJeunesGardes.mp3 music/MaBlondeAllonsAuDevantDeLaVie.mp3 music/LaMarseillaiseAldaNormalized.mp3

= 1936

Ever since the anti-parliamentary riots of February 1934, <span style="color: #000091;">French</span> democracy has been in a state of crisis. Fear of a <span style="color: var(--ppf);">far</span>-<span style="color: var(--nsdap);">right</span> coup has catalyzed the formation of a Popular Front, for the first time bringing the <span style="color: var(--sfio);">socialists</span>, <span style="color: var(--pcf);">communists</span>, <span style="color: var(--prrrs);">radicals</span>, and trade unions into a political alliance against incipient <span style="color: var(--ppf);">fascism</span>. In addition, <span style="color: #000091;">French</span> workers have been feeling the weight of the Great Depression and Prime Minister Laval's policies of austerity. Abroad, <span style="color: var(--nsdap);">fascist</span> <span style="color: #008C45;">Italy</span> is engaging in imperialist expansionism and <span style="color: var(--nsdap);">Nazi Germany</span> is rapidly remilitarizing. <span style="color: #000091;">France</span> is deeply divided between confrontation and appeasement towards the dictators.

Will the Popular Front bring bread, peace, and liberty to <span style="color: #000091;">France</span>? Elections will be held this year, and the people's hopes are high.
