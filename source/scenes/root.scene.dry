= Social Democracy: Popular Front

@start_menu_2
  
- @start: Start game

@start
on-arrival: {!
  
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 1936;
Q.month = 1;
Q.time_in_government = 0;
// how many actions have been taken this month?
Q.month_actions = 0;
Q.month_party_actions = 0;
Q.month_gov_actions = 0;
// limit on the number of party and government actions per month
Q.max_party_actions = 1;
Q.max_gov_actions = 2;
Q.max_actions = 1;
Q.max_advisors = 4;

// "Global max gov actions" is the maximum of max_gov_actions
Q.global_max_gov_actions = 7;
Q.global_max_gov_actions_coalition = 3;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// use decimals for seats
Q.use_decimals = 1;

// party resources
Q.resources = 2;
// party dues
Q.dues = 2;

// the state of the party
// overall dissent reduces every increase in party support.
Q.dissent = 0.05;
Q.dissent_percent = 5;

// factions
// left: Revolutionary Left, Center: Guesdist, Reformists, neosocialists???
Q.factions = ['revolutionary_left', 'socialist_battle', 'center', 'reformist', 'neosocialist', 'pacifist'];
// should this be normalized to 100%?
Q.revolutionary_left_strength = 15;
Q.revolutionary_left_dissent = 20;
Q.socialist_battle_strength = 20;
Q.socialist_battle_dissent = 20;
Q.center_strength = 60;
