title: Status
on-arrival: {!if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
Q.party_actions_remaining = Q.max_party_actions - Q.month_party_actions;
Q.gov_actions_remaining = Q.max_actions - Q.month_actions;!}
new-page: true
is-special: true

